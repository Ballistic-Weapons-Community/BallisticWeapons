	ImgColors(3)=(R=31,G=36,B=48,A=255)
	ImgColors(4)=(R=22,G=23,B=27,A=255)
	FontColors(0)=(R=230,G=232,B=238,A=255)
	FontColors(1)=(R=255,G=255,B=255,A=255)
